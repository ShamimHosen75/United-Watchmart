/**
 * Writes supabase/seed.sql from lib/demo-data.ts so the real database starts with the same sample data.
 * Run: npm run seed:generate
 */
import { writeFileSync } from "node:fs";
import * as d from "../lib/demo-data.ts";

const q = (v: unknown): string =>
  v === null || v === undefined ? "null"
    : typeof v === "number" || typeof v === "boolean" ? String(v)
    : Array.isArray(v) ? `array[${v.map(q).join(",")}]::text[]`
    : `'${String(v).replace(/'/g, "''")}'`;
const ago = (m: number) => `now() - interval '${Math.round(m)} minutes'`;
const rows = (table: string, cols: string[], values: string[][]) =>
  values.length ? `insert into ${table} (${cols.join(", ")}) values\n  ${values.map((v) => `(${v.join(", ")})`).join(",\n  ")};\n` : "";

let sql = "-- Generated by scripts/gen-seed.mts. Sample data for United WatchMart.\n-- Staff accounts are not seeded: sign up in the admin and the first account becomes the owner.\n\n";
sql += rows("branches", ["id", "code", "name", "city", "address", "phone", "email", "opening_hours"], d.branches.map((b) => [q(b.id), q(b.code), q(b.name), q(b.city), q(b.address), q(b.phone), q(b.email), q(b.opening_hours)]));
sql += rows("brands", ["id", "name", "slug", "country", "founded_year", "description", "sort_order", "is_featured", "is_active"],
  d.brands.map((b) => [q(b.id), q(b.name), q(b.slug), q(b.country), q(b.founded_year), q(b.description), q(b.sort_order ?? 0), q(b.is_featured ?? false), q(b.is_active ?? true)]));
sql += rows("collections", ["id", "name", "slug", "description", "sort_order", "is_active"],
  d.collections.map((c) => [q(c.id), q(c.name), q(c.slug), q(c.description), q(c.sort_order ?? 0), q(c.is_active ?? true)]));
const pcols = ["id", "sku", "ref_number", "slug", "name", "tagline", "brand_id", "collection_id", "status", "is_published", "case_mm", "case_material", "bezel", "dial", "movement", "calibre", "power_reserve_h", "water_resistance_m", "strap", "strap_detail", "gender", "cost_price", "price", "warranty_months"] as const;
sql += rows("products", [...pcols], d.products.map((p) => pcols.map((c) => q(p[c]))));
const ccols = ["id", "full_name", "email", "phone", "city", "country", "birthday", "wrist_size_mm", "preferred_branch_id", "is_vip", "marketing_opt_in", "tags", "notes"] as const;
sql += rows("customers", [...ccols], d.customers.map((c) => ccols.map((k) => q(c[k]))));
sql += rows("stock_items", ["id", "product_id", "branch_id", "serial_number", "status", "condition", "cost_price", "has_box", "has_papers", "location_note", "received_at", "sold_at"],
  d.stockSeeds.map((s) => [q(s.id), q(s.product_id), q(s.branch_id), q(s.serial_number), q(s.status), q(s.condition), q(s.cost_price), q(s.has_box), q(s.has_papers), q(s.location_note), ago(s.received_ago), s.sold_ago === null ? "null" : ago(s.sold_ago)]));
sql += rows("orders", ["id", "number", "customer_id", "branch_id", "channel", "status", "subtotal", "discount", "total", "amount_paid", "placed_at"],
  d.orderSeeds.map((o) => [q(o.id), q(o.number), q(o.customer_id), q(o.branch_id), q(o.channel), q(o.status), q(o.unit_price), q(o.discount), q(o.unit_price - o.discount), q(d.seedPaid(o)), ago(o.placed_ago)]));
sql += rows("payments", ["order_id", "method", "amount", "paid_at"], d.orderSeeds.map((o) => [q(o.id), q(o.method), q(d.seedPaid(o)), ago(o.placed_ago)]));
sql += rows("warranties", ["stock_item_id", "order_id", "customer_id", "starts_on", "ends_on"],
  d.orderSeeds.map((o) => [q(o.stock_item_id), q(o.id), q(o.customer_id), `(${ago(o.placed_ago)})::date`, `(${ago(o.placed_ago)})::date + interval '24 months'`]));
sql += rows("order_items", ["order_id", "product_id", "stock_item_id", "unit_price", "discount"],
  d.orderSeeds.map((o) => [q(o.id), q(o.product_id), q(o.stock_item_id), q(o.unit_price), q(o.discount)]));
sql += rows("viewing_requests", ["id", "customer_id", "name", "email", "phone", "product_id", "branch_id", "preferred_at", "status", "source", "message", "created_at"],
  d.viewingSeeds.map((v) => { const c = d.customers[v.customer]; return [q(v.id), q(c.id), q(c.full_name), q(c.email), q(c.phone), q(d.products[v.product].id), q(d.branches[v.branch].id), ago(-v.in_hours * 60), q(v.status), q(v.source), q(v.message), ago(v.created_ago)]; }));
sql += rows("repairs", ["id", "number", "customer_id", "branch_id", "brand_text", "model_text", "serial_number", "issue", "intake_notes", "diagnosis", "status", "under_warranty", "estimate", "final_cost", "paid_amount", "promised_at", "received_at"],
  d.repairSeeds.map((r) => [q(r.id), q(r.number), q(d.customers[r.customer].id), q(d.branches[r.branch].id), q(r.brand), q(r.model), q(r.serial), q(r.issue), q(r.intake), q(r.diagnosis), q(r.status), q(r.warranty), q(r.estimate),
    r.status === "ready" || r.status === "collected" ? q(r.estimate) : "null", r.status === "collected" ? q(r.estimate) : "0", `current_date + ${r.promised_in_days}`, ago(r.received_ago)]));
sql += rows("suppliers", ["id", "name", "contact_name", "email", "phone", "address", "country", "payment_terms", "notes"],
  d.suppliers.map((x) => [q(x.id), q(x.name), q(x.contact_name), q(x.email), q(x.phone), q(x.address), q(x.country), q(x.payment_terms), q(x.notes)]));
sql += rows("purchases", ["id", "number", "supplier_id", "branch_id", "status", "ordered_at", "expected_at", "received_at", "shipping_cost", "total"],
  d.purchaseSeeds.map((po) => [q(po.id), q(po.number), q(d.suppliers[po.supplier].id), q(d.branches[po.branch].id), q(po.status),
    po.ordered_days_ago === null ? "null" : `current_date - ${po.ordered_days_ago}`, po.expected_in_days === null ? "null" : `current_date + ${po.expected_in_days}`,
    po.status === "received" ? ago(-po.expected_in_days! * 1440) : "null", q(po.shipping), q(po.shipping + po.lines.reduce((t, l) => t + l.qty * l.cost, 0))]));
sql += rows("purchase_items", ["purchase_id", "product_id", "quantity", "received_qty", "unit_cost"],
  d.purchaseSeeds.flatMap((po) => po.lines.map((l) => [q(po.id), q(d.products[l.product].id), q(l.qty), q(l.received), q(l.cost)])));
const table = (name: string, list: readonly Record<string, unknown>[], skip: string[] = []) => {
  if (!list.length) return "";
  const cols = Object.keys(list[0]).filter((c) => !skip.includes(c));
  return rows(name, [...cols, ...(skip.includes("created_ago") ? ["created_at"] : [])],
    list.map((r) => [...cols.map((c) => q(r[c])), ...(skip.includes("created_ago") ? [ago(Number(r.created_ago))] : [])]));
};
sql += table("checkout_leads", d.checkoutLeadSeeds, ["created_ago"]);
sql += table("site_slides", d.slideSeeds);
sql += table("reviews", d.reviewSeeds, ["created_ago"]);
sql += table("tryon_settings", d.tryonSeeds);
sql += table("coupons", d.couponSeeds);
sql += table("shipping_zones", d.shippingZoneSeeds);
sql += table("shipping_methods", d.shippingMethodSeeds);
sql += "\n-- Keep generated document numbers clear of the seeded ones\nselect setval('order_number_seq', 2000);\nselect setval('repair_number_seq', 200);\nselect setval('purchase_number_seq', 200);\nselect setval('transfer_number_seq', 20);\n";

writeFileSync(new URL("../supabase/seed.sql", import.meta.url), sql);
console.log("Wrote supabase/seed.sql");

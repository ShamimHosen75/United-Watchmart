# Leave both empty to run in demo mode with in-memory sample data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
ALLOWED_ORIGIN=https://your-website.example

# Optional (see README "Optional settings")
NEXT_PUBLIC_CURRENCY=USD
# Website address for the "Back to store" link (falls back to Settings → Store website)
NEXT_PUBLIC_STORE_URL=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM=United WatchMart <hello@yourdomain.com>
# Website content: lets Publish refresh the website straight away (docs/website-content.md)
SITE_REVALIDATE_URL=
SITE_REVALIDATE_SECRET=

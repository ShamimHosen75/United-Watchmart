# Public site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://unitedwatchmart.com

# Resend (enquiry emails) — used from Phase 4
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL="United WatchMart <boutique@unitedwatchmart.com>"
BOUTIQUE_EMAIL=

# Cloudflare Turnstile — used from Phase 4
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set to true to log enquiry emails instead of sending them (local testing)
ENQUIRY_DRY_RUN=false

# Database (Phase 5) — Supabase: Project settings → Database → Connection string.
# Use the transaction pooler (port 6543) for the app. For `npm run db:migrate`, the session
# pooler or direct connection works best. Leave empty locally to use the embedded PGlite database.
DATABASE_URL=

# Stripe (Phase 5) — test keys from Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint (or `stripe listen`). Events: payment_intent.succeeded,
# payment_intent.canceled, charge.refunded. URL: https://<domain>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Admin (Phase 5) — generate both with: npm run admin:hash -- "a long passphrase"
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

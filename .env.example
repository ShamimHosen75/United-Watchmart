# Public site URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://unitedwatchmart.com

# Resend (enquiry emails) — used from Phase 4
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL="United WatchMart <boutique@unitedwatchmart.com>"
BOUTIQUE_EMAIL=

# Cloudflare Turnstile — used from Phase 4
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set to true to log enquiry emails instead of sending them (local testing)
ENQUIRY_DRY_RUN=false
